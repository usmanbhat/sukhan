<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_card_light"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/widgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SUKHAN · DAILY VERSE"
        android:textColor="#5C5C57"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widgetQuote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="سخن"
        android:textColor="#191917"
        android:textSize="21sp"
        android:fontFamily="serif"
        android:textDirection="rtl"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/widgetSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Poet · Poem"
        android:textColor="#5C5C57"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/widgetShare"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:background="@drawable/widget_button_light"
        android:text="Share as image"
        android:textColor="#191917"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
